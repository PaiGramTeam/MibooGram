{% set boss = data.floor.boss[0] %}
 <div class="floors">
        <div class="floor floor-mem" style="display: flex">
            <div class="head" style="flex: 1">
                <div style="margin: 80px;">
                    <div style="background: url('{{ boss.bg_icon }}');">
                        <img src="{{ boss.icon }}" style="width: 200px; width: 140px;">
                    </div>
                </div>
            </div>
            <div class="chamber" style="flex: 2">
                <div class="chamber-info" style="display: block; height: auto">
                    <div style="padding: 20px">
                        <span>{{ boss.name }}</span>
                    </div>
                    <div style="padding: 10px;">
                        <span>分数：{{ data.floor.score }}</span>
                        <div class="star">
                            {% for _ in range(data.floor.star) %}
                            <div class="icon icon2 starL"></div>
                            {% endfor %}
                        </div>
                    </div>
                    <div style="margin: 10px">
                        <span style="color: white;">通关时刻：{{ data.floor_time }}</span>
                    </div>
                </div>
                <div class="battles">
                    <div class="battle">
                        {% for character in data.floor.avatar_list %}
                            <div class="character">
                                <div class="element" style="background-image: url('../../img/attribute/{{ character.element_type }}.png')"></div>
                                <div class="icon"
                                     style="background-image: url('../../background/rarity/half/{{ character.rarity }}.png')">
                                    <img src="{{ character_icons[character.id] }}" alt=""/>
                                </div>
                                <div class="caption">Lv.{{ character.level }}</div>
                            </div>
                        {% endfor %}
                        {% if data.floor.buddy %}
                            {% set character = data.floor.buddy %}
                            <div class="character">
                                <div class="icon"
                                     style="background-image: url('../../background/rarity/half/{{ character.rarity }}.png')">
                                    <img src="{{ buddy_icons[character.id] }}" alt=""/>
                                </div>
                                <div class="caption">Lv.{{ character.level }}</div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
 </div>